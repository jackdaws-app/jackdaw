{
  "manifest_version": 3,
  "_comment_minimum_chrome_version": "140 is the floor for chrome.storage.local.setAccessLevel, which background.js uses to keep the session token out of content scripts. The method is documented on the shared StorageArea interface badged 102+, which reads as universally available and is not: only storage.session had it before 140. Declared rather than feature-detected on purpose. A guarded call that silently no-ops would leave the token readable on older Chrome while the code read as if it were protected.",
  "minimum_chrome_version": "140",
  "name": "Jackdaw — Micro Center Price History",
  "version": "0.2.0",
  "description": "Community price history, charts, and discussion for Micro Center products.",
  "permissions": ["storage", "alarms", "notifications", "clipboardWrite"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.microcenter.com/product/*"],
      "js": ["page-world.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.microcenter.com/product/*"],
      "js": ["chart.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.microcenter.com/search/*",
        "https://www.microcenter.com/category/*"
      ],
      "js": ["catalog-world.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.microcenter.com/search/*",
        "https://www.microcenter.com/category/*"
      ],
      "js": ["catalog.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://www.microcenter.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Jackdaw",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
